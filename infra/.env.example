# Copy to infra/.env on the VPS. Never commit real values. Browser bundles receive only VITE_* public config.
# deploy/install.sh writes this file for you at mode 600; this template documents what it contains.
INGEST_HOST=ingest.phillyshah.com       # the hostname Traefik routes to these containers
APP_ORIGIN=https://ingest.phillyshah.com
API_ROOT_PATH=/api                      # public prefix; the API itself serves /v1 (spec §22B)

# staging, not production: the reviewer UI still uses the development header shim, so there is no per-person
# identity, and this deployment has no edge authentication either — anyone who knows the address can open it and
# select any role. Tolerable only while every pack is unsigned_placeholder and there is no patient data.
# Setting this to `production` while AUTH_MODE=shim makes the API refuse every request, by design; that guard is
# deliberately left intact.
MOVEAI_ENV=staging

# Database: the owner's Supabase project (confirm the exact project before running migrations, spec §22C).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require   # backend/worker connection (never in the browser)
SUPABASE_URL=https://PROJECT.supabase.co                                       # public client config
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key-only                                    # publishable key only; service role stays server-side
SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-expose
SUPABASE_STORAGE_BUCKET=moveai-ingest-private                                  # private bucket for permitted graphics/source files

# Auth: shim for development; Supabase JWT verification in production (see docs/runbooks/supabase-deployment.md).
# Access is invitation-only: an administrator sets app_user.auth_user_id to the Supabase auth.users.id.
AUTH_MODE=shim                          # shim | supabase. MOVEAI_ENV=production refuses the shim outright.
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_SECRET=                  # legacy shared-secret projects only; omit to verify against the project JWKS
JWKS_CACHE_SECONDS=300
PLAN_SIGNING_SECRET=generate-a-long-random-secret

# Destructive-operation guard. Leave unset. scripts/migrate.py --reset drops the public schema and refuses to run
# without this, and refuses entirely against a managed host.
# ALLOW_DESTRUCTIVE_RESET=

# Queue / workers (Postgres-backed queue, ADR-0002)
WORKER_POLL_SECONDS=2
WORKER_CONCURRENCY=1
MAX_DOCUMENT_BYTES=26214400
MAX_GRAPHIC_BYTES=2097152
# The curated allowlist lives in the database (`source_policy`), not here: see docs/runbooks/source-allowlist.md.
# This variable is an escape hatch for a one-off domain. It carries no licence, no evidence and no rights
# reviewer's signature, so anything fetched through it arrives with no rights grant and holds at the first stage.
ALLOWED_FETCH_DOMAINS=                  # comma-separated; empty = the curated allowlist and owned files only

# The API shares one connection pool. Supabase's session pooler admits 15 clients in total, and the worker,
# scheduler and any migration run each hold one, so keep this well under 15. A request that finds the pool full
# waits DB_POOL_WAIT_S seconds for a free connection before failing.
DB_POOL_MAX=6
DB_POOL_WAIT_S=15

# Automatic source discovery for campaigns (spec §21, milestone M7). `sitemap` reads the robots.txt and sitemaps
# of every listed publisher (signed or not — those files exist for crawlers and carry no content) and scores the
# pages against the condition's names. `search` adds a web search API. Neither makes a page readable: fetching
# still requires the publisher's signed terms; everything else found is parked as pending, never fetched.
# Unset = both on staging/production, none anywhere else (tests and CI must never touch the network).
DISCOVERY_PROVIDERS=sitemap,search      # comma-separated subset of: sitemap, search — or none
SEARCH_PROVIDER=                        # brave | mock | none. Empty = brave when the key below is set, else none
BRAVE_SEARCH_API_KEY=                   # https://brave.com/search/api/ — one query = one request against max_search_requests
ALLOWED_FILE_ROOTS=/srv/moveai/uploads   # clinician uploads

# Model provider (ADR-0006). Leave the key unset to run the deterministic mock.
# IMPORTANT: with the mock, ingesting a document returns fixture output rather than anything actually read from
# that document. Campaign results will look real and are not. Set a key before reading extraction results as
# findings about a source.
#
# Only ONE stage of this system calls a model: extraction, which reads one already-parsed document into a fixed
# schema. Eligibility, rules, ranking, dose envelopes, routing and validation are all deterministic code, so the
# model choice affects that single stage and nothing else.
# Naming a provider without its key now raises instead of quietly falling back to mock-1: the mock's fixture
# output is indistinguishable from a real extraction, so a silent downgrade would fill the review queue with
# confident findings that were read from nothing.
EXTRACTION_MODEL=mock-1                 # mock-1 | anthropic-1 | openrouter-1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5        # cheapest current model; 200K context, ample for a 120K-char document

# OpenRouter, for running extraction on an open-weight model. Cost is taken from OpenRouter's own reported
# figure per call, so the campaign spend caps stay accurate without a local rate table.
# No patient data ever reaches any model: extraction only ever sees fetched source documents, and the planner
# — which is the only thing that touches case data — makes no model calls at all.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Leave the two prices unset unless billing through Bedrock or Vertex, which charge different rates: the code
# prices each model from its own published rate, and an unknown model is charged at the dearest known rate so a
# mispriced model cannot spend past a campaign cap unnoticed.
# PRICE_IN_PER_MTOK=
# PRICE_OUT_PER_MTOK=

# Campaign budgets (tenant-wide ceilings; per-campaign limits are set in the form)
TENANT_DAILY_USD_CAP=25
TENANT_DAILY_FETCH_CAP=500

# Integration events
MOVEAI_WEBHOOK_URL=
MOVEAI_WEBHOOK_SECRET=
