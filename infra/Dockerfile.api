FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_SYSTEM_PYTHON=1
RUN pip install --no-cache-dir uv==0.8.17
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY packages ./packages
COPY services ./services
COPY adapters ./adapters
COPY db ./db
COPY scripts ./scripts
COPY fixtures ./fixtures
RUN uv sync --frozen --no-dev --all-packages
RUN useradd -r -u 10001 moveai && chown -R moveai /app
# The clinician-upload mount point (ALLOWED_FILE_ROOTS, infra/.env.example): /sources/upload writes here as the
# unprivileged `moveai` user, and the worker container reads the same named volume back read-only. A fresh named
# volume is seeded from whichever image first supplies this path, so both Dockerfiles create it (see
# Dockerfile.worker) with the same world-writable, sticky-bit permissions — matching users are not guaranteed
# across the two images, and without this the mount point is created by Docker owned by root, and every upload
# 500s on a permission-denied write.
RUN mkdir -p /srv/moveai/uploads && chmod 1777 /srv/moveai/uploads
# See Dockerfile.worker: the object-storage volume the worker writes fetched bytes and extracted images to.
# GET /media/{id}/file reads it back from here, so this container needs it mounted too (read-only — this
# container never writes to it). Created with the same permissions for the same volume-seeding-race reason.
RUN mkdir -p /app/.demo-out/storage && chmod 1777 /app/.demo-out/storage
USER moveai
ARG GIT_SHA=unknown
ARG BUILT_AT=unknown
ENV GIT_SHA=$GIT_SHA BUILT_AT=$BUILT_AT

EXPOSE 8000
# Call the venv directly rather than through `uv run`: uv wants a cache under $HOME, and this image runs as a
# system account with no home directory, so `uv run` dies with "failed to create directory ... Permission
# denied" before Python starts. Nothing needs resolving at runtime anyway — the venv is already built.
CMD ["/app/.venv/bin/uvicorn", "moveai_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
