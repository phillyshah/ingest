FROM node:22-alpine AS build
WORKDIR /app
COPY apps/reviewer/package.json apps/reviewer/pnpm-lock.yaml* ./apps/reviewer/
COPY pnpm-workspace.yaml package.json* ./
RUN corepack enable && cd apps/reviewer && pnpm install --frozen-lockfile
COPY apps/reviewer ./apps/reviewer
COPY packages/contracts/openapi.json ./packages/contracts/openapi.json
RUN cd apps/reviewer && pnpm build

FROM caddy:2-alpine
COPY --from=build /app/apps/reviewer/dist /srv/reviewer
COPY infra/Caddyfile.reviewer /etc/caddy/Caddyfile
